{
  "name": "@statsim/gen",
  "version": "0.0.5",
  "description": "Generate synthetic tabular data with JSEE",
  "type": "commonjs",
  "main": "model.js",
  "exports": {
    ".": {
      "require": "./model.js",
      "default": "./model.js"
    },
    "./schema.json": "./schema.json",
    "./model.js": "./model.js",
    "./package.json": "./package.json"
  },
  "jsee": "schema.json",
  "sideEffects": false,
  "files": [
    "bin/",
    "schema.json",
    "model.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "serve": "jsee schema.json",
    "build": "jsee schema.json -d README.md -o dist/index.html --bundle"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statsim/gen.git"
  },
  "keywords": [
    "statsim",
    "jsee",
    "synthetic-data",
    "data-generation",
    "simulation"
  ],
  "author": "Anton Zemlyansky",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/statsim/gen/issues"
  },
  "homepage": "https://github.com/statsim/gen#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "mkdata": "0.0.6",
    "@jseeio/jsee": "0.8.7"
  },
  "bin": {
    "statsim-gen": "./bin/gen.js"
  }
}
